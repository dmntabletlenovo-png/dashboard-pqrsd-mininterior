   288	// Export Function
   289	const exportToCSV = (documentos: DocumentoPQRSD[], filename: string) => {
   290	  const headers = ['ID', 'Radicado', 'Fecha Radicación', 'Serie', 'Subserie', 'Tipología', 'Clasificación', 'Asunto', 'Estado', 'Oficina', 'Gestor', 'Días', 'Rangos'];
   291	  const rows = documentos.map(doc => [
   292	    doc.id, doc.radicado, doc.fechaRadicacion, doc.serie, doc.subserie, 
   293	    doc.tipologia, doc.clasificacion, `"${doc.asunto.replace(/"/g, '""')}"`, 
   294	    doc.estado, doc.oficina, doc.gestor, doc.dias, doc.rangos
   295	  ]);
   296	  
   297	  const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
   298	  const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
   299	  const link = document.createElement('a');
   300	  link.href = URL.createObjectURL(blob);
   301	  link.download = `${filename}_${new Date().toISOString().split('T')[0]}.csv`;
   302	  link.click();
   303	};
