    27	// KPI Card Component
    28	const KPICard = ({ 
    29	  title, 
    30	  value, 
    31	  icon: Icon, 
    32	  color, 
    33	  trend, 
    34	  subtitle 
    35	}: { 
    36	  title: string; 
    37	  value: string | number; 
    38	  icon: any; 
    39	  color: string; 
    40	  trend?: number; 
    41	  subtitle?: string;
    42	}) => (
    43	  <motion.div
    44	    initial={{ opacity: 0, y: 20 }}
    45	    animate={{ opacity: 1, y: 0 }}
    46	    className="relative overflow-hidden rounded-xl p-6"
    47	    style={{ backgroundColor: colors.card, border: `1px solid ${colors.border}` }}
    48	  >
    49	    <div className="absolute top-0 right-0 w-32 h-32 opacity-10" 
    50	         style={{ background: `radial-gradient(circle, ${color} 0%, transparent 70%)` }} />
    51	    <div className="flex items-start justify-between">
    52	      <div>
    53	        <p className="text-sm font-medium" style={{ color: colors.textMuted }}>{title}</p>
    54	        <p className="text-3xl font-bold mt-2" style={{ color }}>{value}</p>
    55	        {subtitle && <p className="text-xs mt-1" style={{ color: colors.textMuted }}>{subtitle}</p>}
    56	        {trend !== undefined && (
    57	          <div className="flex items-center mt-2">
    58	            <TrendingUp size={14} className={trend >= 0 ? 'text-green-500' : 'text-red-500'} />
    59	            <span className={`text-xs ml-1 ${trend >= 0 ? 'text-green-500' : 'text-red-500'}`}>
