   305	// Main Dashboard Component
   306	export default function Dashboard() {
   307	  const [filtros, setFiltros] = useState<Filtros>({
   308	    serie: '',
   309	    subserie: '',
   310	    oficina: '',
   311	    rangoDias: '',
   312	    busqueda: ''
   313	  });
   314	  
   315	  const [showFilters, setShowFilters] = useState(false);
   316	  const [activeTab, setActiveTab] = useState<'overview' | 'analysis' | 'alerts' | 'export'>('overview');
   317	  
   318	  // Apply filters
   319	  const documentosFiltrados = useMemo(() => {
   320	    return data.documentos.filter(doc => {
   321	      if (filtros.serie && !doc.serie.includes(filtros.serie)) return false;
   322	      if (filtros.subserie && !doc.subserie.includes(filtros.subserie)) return false;
   323	      if (filtros.oficina && !doc.oficina.includes(filtros.oficina)) return false;
   324	      if (filtros.rangoDias && doc.rangos !== filtros.rangoDias) return false;
   325	      if (filtros.busqueda) {
   326	        const searchLower = filtros.busqueda.toLowerCase();
   327	        if (!doc.asunto.toLowerCase().includes(searchLower) && 
   328	            !doc.radicado.toLowerCase().includes(searchLower) &&
   329	            !doc.firmante.toLowerCase().includes(searchLower)) {
   330	          return false;
   331	        }
   332	      }
   333	      return true;
   334	    });
   335	  }, [filtros]);
   336	  
   337	  // Filtered stats
   338	  const statsFiltrados = useMemo(() => {
   339	    const stats = {
   340	      total: documentosFiltrados.length,
   341	      documentosVencidos: 0,
   342	      documentosPendientes: 0,
   343	      diasPromedio: 0,
   344	      porSerie: {} as Record<string, number>,
   345	      porSubserie: {} as Record<string, number>,
   346	      porOficina: {} as Record<string, number>,
   347	      porRangoDias: {} as Record<string, number>
   348	    };
   349	    
   350	    let totalDias = 0;
   351	    let countDias = 0;
   352	    
   353	    documentosFiltrados.forEach(doc => {
   354	      stats.porSerie[doc.serie] = (stats.porSerie[doc.serie] || 0) + 1;
   355	      stats.porSubserie[doc.subserie] = (stats.porSubserie[doc.subserie] || 0) + 1;
   356	      stats.porOficina[doc.oficina] = (stats.porOficina[doc.oficina] || 0) + 1;
   357	      stats.porRangoDias[doc.rangos] = (stats.porRangoDias[doc.rangos] || 0) + 1;
   358	      
   359	      if (doc.dias > 0) {
   360	        totalDias += doc.dias;
   361	        countDias++;
   362	      }
   363	      
   364	      if (doc.fechaVencimiento) {
   365	        const vencimiento = new Date(doc.fechaVencimiento);
   366	        if (vencimiento < new Date()) {
   367	          stats.documentosVencidos++;
   368	        } else {
   369	          stats.documentosPendientes++;
   370	        }
   371	      }
   372	    });
   373	    
   374	    stats.diasPromedio = countDias > 0 ? Math.round(totalDias / countDias) : 0;
   375	    
   376	    return stats;
   377	  }, [documentosFiltrados]);
   378	  
   379	  // Alerts based on data
   380	  const alertas = useMemo(() => {
   381	    const alerts = [];
   382	    
   383	    // Alert for documents over 1000 days
   384	    const docsOver1000 = documentosFiltrados.filter(d => d.dias > 1000).length;
   385	    if (docsOver1000 > 0) {
   386	      alerts.push({
   387	        titulo: 'Documentos con más de 1000 días de trámite',
   388	        descripcion: `Hay ${docsOver1000.toLocaleString()} documentos que llevan más de 1000 días sin resolver. Se requiere atención inmediata.`,
   389	        tipo: 'danger' as const,
   390	        fecha: 'Revisión continua'
   391	      });
   392	    }
   393	    
   394	    // Alert for high volume series
   395	    const topSeries = Object.entries(statsFiltrados.porSerie).sort((a, b) => b[1] - a[1])[0];
   396	    if (topSeries) {
   397	      alerts.push({
   398	        titulo: `Alta demanda en: ${topSeries[0]}`,
   399	        descripcion: `${topSeries[1].toLocaleString()} documentos en esta serie. Considerar asignar más recursos.`,
   400	        tipo: 'warning' as const,
   401	        fecha: 'Alerta automática'
   402	      });
   403	    }
   404	    
   405	    // Alert for pending documents
   406	    if (statsFiltrados.documentosPendientes > 1000) {
   407	      alerts.push({
   408	        titulo: 'Volumen alto de documentos pendientes',
   409	        descripcion: `${statsFiltrados.documentosPendientes.toLocaleString()} documentos con fecha de vencimiento por vencer.`,
   410	        tipo: 'warning' as const,
   411	        fecha: 'Monitoreo en tiempo real'
   412	      });
   413	    }
   414	    
   415	    return alerts;
   416	  }, [documentosFiltrados, statsFiltrados]);
   417	  
   418	  return (
   419	    <div className="min-h-screen" style={{ backgroundColor: colors.bg }}>
   420	      {/* Header */}
   421	      <header className="sticky top-0 z-50 border-b" 
   422	              style={{ backgroundColor: colors.card, borderColor: colors.border }}>
   423	        <div className="max-w-7xl mx-auto px-4 py-4">
   424	          <div className="flex items-center justify-between">
   425	            <div className="flex items-center gap-3">
   426	              <div className="p-2 rounded-lg" style={{ backgroundColor: `${colors.secondary}20` }}>
   427	                <FileText size={24} style={{ color: colors.secondary }} />
   428	              </div>
   429	              <div>
   430	                <h1 className="text-xl font-bold" style={{ color: colors.text }}>
   431	                  Dashboard PQRSD
   432	                </h1>
   433	                <p className="text-xs" style={{ color: colors.textMuted }}>
   434	                  Ministerio del Interior - Asuntos Indígenas, ROM y Minorías
   435	                </p>
   436	              </div>
   437	            </div>
   438	            
   439	            <div className="flex items-center gap-4">
   440	              <div className="flex items-center gap-2 px-3 py-1.5 rounded-lg" 
   441	                   style={{ backgroundColor: `${colors.success}20` }}>
   442	                <div className="w-2 h-2 rounded-full animate-pulse" style={{ backgroundColor: colors.success }} />
   443	                <span className="text-xs font-medium" style={{ color: colors.success }}>En tiempo real</span>
   444	              </div>
   445	              
   446	              <button 
   447	                onClick={() => setShowFilters(!showFilters)}
   448	                className="flex items-center gap-2 px-4 py-2 rounded-lg transition-colors"
   449	                style={{ 
   450	                  backgroundColor: showFilters ? colors.secondary : 'transparent',
   451	                  color: showFilters ? 'white' : colors.textMuted,
   452	                  border: `1px solid ${colors.border}`
   453	                }}
   454	              >
   455	                <Filter size={16} />
   456	                <span className="text-sm">Filtros</span>
   457	              </button>
   458	            </div>
   459	          </div>
   460	        </div>
   461	      </header>
   462	      
   463	      {/* Filters Panel */}
   464	      <AnimatePresence>
   465	        {showFilters && (
   466	          <motion.div
   467	            initial={{ height: 0, opacity: 0 }}
   468	            animate={{ height: 'auto', opacity: 1 }}
   469	            exit={{ height: 0, opacity: 0 }}
   470	            className="overflow-hidden border-b"
   471	            style={{ backgroundColor: colors.card, borderColor: colors.border }}
   472	          >
   473	            <div className="max-w-7xl mx-auto px-4 py-4">
   474	              <div className="grid grid-cols-1 md:grid-cols-5 gap-4">
   475	                <div>
   476	                  <label className="block text-xs font-medium mb-1" style={{ color: colors.textMuted }}>
   477	                    Serie Documental
   478	                  </label>
   479	                  <select
   480	                    value={filtros.serie}
   481	                    onChange={(e) => setFiltros({ ...filtros, serie: e.target.value })}
   482	                    className="w-full px-3 py-2 rounded-lg text-sm"
   483	                    style={{ backgroundColor: colors.bg, color: colors.text, border: `1px solid ${colors.border}` }}
   484	                  >
   485	                    <option value="">Todas</option>
   486	                    {Object.keys(data.estadisticas.porSerie).sort().map(serie => (
   487	                      <option key={serie} value={serie}>{serie}</option>
   488	                    ))}
   489	                  </select>
   490	                </div>
   491	                
   492	                <div>
   493	                  <label className="block text-xs font-medium mb-1" style={{ color: colors.textMuted }}>
   494	                    Rango de Días
   495	                  </label>
   496	                  <select
   497	                    value={filtros.rangoDias}
   498	                    onChange={(e) => setFiltros({ ...filtros, rangoDias: e.target.value })}
   499	                    className="w-full px-3 py-2 rounded-lg text-sm"
   500	                    style={{ backgroundColor: colors.bg, color: colors.text, border: `1px solid ${colors.border}` }}
   501	                  >
   502	                    <option value="">Todos</option>
