    72	// Bar Chart Component
    73	const BarChart = ({ 
    74	  data, 
    75	  maxValue, 
    76	  labelKey, 
    77	  valueKey, 
    78	  color = colors.secondary,
    79	  maxItems = 8
    80	}: { 
    81	  data: any[]; 
    82	  maxValue: number; 
    83	  labelKey: string; 
    84	  valueKey: string; 
    85	  color?: string;
    86	  maxItems?: number;
    87	}) => {
    88	  const displayData = data.slice(0, maxItems);
    89	  return (
    90	    <div className="space-y-3">
    91	      {displayData.map((item, index) => (
    92	        <div key={index} className="flex items-center gap-3">
    93	          <span className="text-xs w-32 truncate" style={{ color: colors.textMuted }}>
    94	            {item[labelKey]}
    95	          </span>
    96	          <div className="flex-1 h-6 rounded-full overflow-hidden" style={{ backgroundColor: `${color}20` }}>
    97	            <motion.div
    98	              initial={{ width: 0 }}
    99	              animate={{ width: `${(item[valueKey] / maxValue) * 100}%` }}
   100	              transition={{ duration: 0.8, delay: index * 0.05 }}
   101	              className="h-full rounded-full"
   102	              style={{ backgroundColor: color }}
   103	            />
   104	          </div>
   105	          <span className="text-sm font-semibold w-16 text-right" style={{ color: colors.text }}>
   106	            {item[valueKey].toLocaleString()}
   107	          </span>
   108	        </div>
   109	      ))}
   110	    </div>
   111	  );
   112	};
   113	
   114	// Line Chart Component
   115	const LineChart = ({ data, color = colors.secondary }: { data: Record<string, number>; color?: string }) => {
   116	  const entries = Object.entries(data).sort((a, b) => a[0].localeCompare(b[0]));
   117	  const maxValue = Math.max(...entries.map(e => e[1]));
   118	  
   119	  return (
   120	    <div className="relative h-48">
   121	      <svg className="w-full h-full" viewBox="0 0 400 150" preserveAspectRatio="none">
   122	        {/* Grid lines */}
   123	        {[0, 1, 2, 3, 4].map(i => (
   124	          <line key={i} x1="0" y1={i * 37.5} x2="400" y2={i * 37.5} 
   125	                stroke={colors.border} strokeWidth="1" opacity="0.3" />
   126	        ))}
   127	        
   128	        {/* Line */}
   129	        <polyline
   130	          fill="none"
   131	          stroke={color}
   132	          strokeWidth="2"
   133	          points={entries.map((e, i) => {
   134	            const x = (i / (entries.length - 1)) * 380 + 10;
   135	            const y = 150 - (e[1] / maxValue) * 140;
   136	            return `${x},${y}`;
   137	          }).join(' ')}
   138	        />
   139	        
   140	        {/* Area under line */}
   141	        <polygon
   142	          fill={`${color}30`}
   143	          points={`10,150 ${entries.map((e, i) => {
   144	            const x = (i / (entries.length - 1)) * 380 + 10;
   145	            const y = 150 - (e[1] / maxValue) * 140;
   146	            return `${x},${y}`;
   147	          }).join(' ')} ${390},150`}
   148	        />
   149	        
   150	        {/* Dots */}
   151	        {entries.map((e, i) => {
   152	          const x = (i / (entries.length - 1)) * 380 + 10;
   153	          const y = 150 - (e[1] / maxValue) * 140;
   154	          return (
   155	            <circle key={i} cx={x} cy={y} r="3" fill={color} />
   156	          );
   157	        })}
   158	      </svg>
   159	      
   160	      {/* Labels */}
   161	      <div className="absolute bottom-0 left-0 right-0 flex justify-between px-2">
   162	        {entries.filter((_, i) => i % Math.ceil(entries.length / 6) === 0).map(([key], i) => (
   163	          <span key={i} className="text-xs" style={{ color: colors.textMuted }}>
   164	            {key.split('-')[1]}/{key.split('-')[0].slice(2)}
   165	          </span>
   166	        ))}
   167	      </div>
   168	    </div>
   169	  );
   170	};
   171	
   172	// Heat Map Component
   173	const HeatMap = ({ oficinas }: { oficinas: Record<string, number> }) => {
   174	  const entries = Object.entries(oficinas)
   175	    .filter(([key]) => key.length > 5)
   176	    .sort((a, b) => b[1] - a[1])
   177	    .slice(0, 20);
   178	  const maxValue = Math.max(...entries.map(e => e[1]));
   179	  
   180	  return (
   181	    <div className="grid grid-cols-4 gap-2">
   182	      {entries.map(([oficina, count], index) => {
   183	        const intensity = count / maxValue;
   184	        const bg = `rgba(37, 99, 235, ${0.2 + intensity * 0.8})`;
   185	        const shortName = oficina.replace('DIRECCION DE ', '').replace('GRUPO DE ', '').substring(0, 25);
   186	        
   187	        return (
   188	          <motion.div
   189	            key={index}
   190	            initial={{ opacity: 0, scale: 0.8 }}
   191	            animate={{ opacity: 1, scale: 1 }}
   192	            transition={{ delay: index * 0.03 }}
   193	            className="p-2 rounded-lg cursor-pointer hover:scale-105 transition-transform"
   194	            style={{ backgroundColor: bg }}
   195	            title={`${oficina}: ${count.toLocaleString()} documentos`}
   196	          >
   197	            <p className="text-xs font-medium truncate" style={{ color: colors.text }}>
   198	              {shortName}
   199	            </p>
   200	            <p className="text-lg font-bold" style={{ color: colors.text }}>
   201	              {count.toLocaleString()}
   202	            </p>
   203	          </motion.div>
   204	        );
   205	      })}
   206	    </div>
   207	  );
   208	};
   209	
   210	// Alert Item Component
